
<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Профільна школа · Інформатична галузь</title>
<style>
:root {
  --bg:#f5f7fc;
  --ink:#19233c;
  --muted:#62718a;
  --line:#dce4f0;
  --purple:#8059dd;
  --mint:#11a99d;
  --orange:#ec943d;
  --pink:#cf6fa5;
}
* { box-sizing:border-box; }
html { scroll-behavior:smooth; }
body {
  margin:0;
  background:var(--bg);
  color:var(--ink);
  font:16px/1.55 "Segoe UI",Arial,sans-serif;
}
button,input { font:inherit; }
button { cursor:pointer; }
.wrap { max-width:1180px; margin:auto; padding:0 22px; }
.hero {
  color:white;
  background:
    radial-gradient(circle at 85% 15%,#315f75 0,transparent 35%),
    radial-gradient(circle at 15% 80%,#3c286e 0,transparent 40%),
    #101b34;
  overflow:hidden;
}
.hero-inner {
  display:grid;
  grid-template-columns:1.4fr 1fr;
  align-items:center;
  gap:30px;
  min-height:370px;
  padding-top:54px;
  padding-bottom:50px;
}
.kicker {
  color:#7ce8d8;
  font-weight:800;
  letter-spacing:.15em;
  font-size:.78rem;
}
h1 {
  font-size:clamp(2.2rem,5vw,4rem);
  line-height:1.1;
  margin:18px 0;
}
.hero p { color:#d3ddf1; max-width:640px; }
.stats { display:flex; gap:12px; flex-wrap:wrap; margin-top:26px; }
.stat {
  min-width:108px;
  background:#ffffff14;
  border:1px solid #ffffff25;
  border-radius:16px;
  padding:13px 18px;
}
.stat strong { display:block; font-size:1.7rem; color:#91f2e2; }
.stat span { font-size:.82rem; color:#d5e0f4; }
.art {
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:14px;
  transform:rotate(-4deg);
}
.art-card {
  background:#ffffff14;
  border:1px solid #ffffff35;
  border-radius:22px;
  min-height:115px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:3.3rem;
  box-shadow:0 15px 30px #0002;
}
.art-card:nth-child(2) { transform:translateY(22px); }
.art-card:nth-child(3) { transform:translateY(-10px); }
.intro {
  padding-top:38px;
  padding-bottom:10px;
}
.intro h2 { font-size:1.7rem; margin:0 0 6px; }
.intro p { color:var(--muted); margin:0; }
.toolbar {
  display:flex;
  flex-wrap:wrap;
  gap:12px;
  align-items:center;
  padding:24px 0;
}
.search {
  flex:1 1 280px;
  padding:13px 16px;
  border:1px solid var(--line);
  border-radius:13px;
  background:white;
  color:var(--ink);
  min-width:0;
}
.filters { display:flex; flex-wrap:wrap; gap:7px; }
.filter {
  border:1px solid var(--line);
  border-radius:11px;
  background:white;
  color:var(--ink);
  padding:10px 14px;
}
.filter.active {
  background:#172746;
  color:white;
  border-color:#172746;
}
.module { margin-bottom:28px; }
.module-head {
  display:flex;
  align-items:center;
  gap:17px;
  padding:22px;
  border-radius:20px 20px 0 0;
  color:white;
  background:var(--accent);
}
.module-icon {
  font-size:2.2rem;
  width:65px;
  height:65px;
  display:grid;
  place-items:center;
  border-radius:17px;
  background:#ffffff25;
}
.module-head small {
  display:block;
  font-weight:800;
  letter-spacing:.12em;
  opacity:.9;
}
.module-head h2 {
  font-size:1.35rem;
  line-height:1.25;
  margin:4px 0;
}
.module-head p { margin:0; opacity:.9; font-size:.9rem; }
.module-count {
  margin-left:auto;
  white-space:nowrap;
  background:#ffffff25;
  padding:7px 12px;
  border-radius:20px;
  font-size:.85rem;
}
.topic-list {
  background:white;
  border:1px solid var(--line);
  border-top:0;
  border-radius:0 0 20px 20px;
  overflow:hidden;
}
.topic + .topic { border-top:1px solid var(--line); }
.topic-toggle {
  width:100%;
  background:white;
  border:0;
  display:flex;
  align-items:center;
  text-align:left;
  padding:20px 23px;
  gap:15px;
  color:var(--ink);
}
.topic-toggle:hover { background:#f7f9fe; }
.number {
  background:#f0edfa;
  color:#6543bc;
  border-radius:11px;
  padding:9px 12px;
  font-weight:800;
  font-size:.85rem;
  flex-shrink:0;
}
.topic-name { flex:1; font-weight:750; }
.arrow { color:#8491a6; transition:transform .2s; }
.topic.open .arrow { transform:rotate(180deg); }
.topic-body {
  display:none;
  background:#f9fbff;
  padding:4px 23px 22px 73px;
}
.topic.open .topic-body { display:block; }
.topic-description {
  color:var(--muted);
  font-size:.91rem;
  margin:0 0 15px;
}
.tasks { display:grid; gap:10px; }
.task {
  display:flex;
  align-items:center;
  gap:13px;
  background:white;
  border:1px solid var(--line);
  border-radius:13px;
  padding:13px 15px;
}
.task-icon {
  background:#eaf7f4;
  color:#168b7c;
  width:43px;
  height:43px;
  display:grid;
  place-items:center;
  border-radius:12px;
  font-size:1.35rem;
  flex-shrink:0;
}
.task-info { flex:1; min-width:0; }
.task-title { font-weight:750; }
.task-desc { color:var(--muted); font-size:.85rem; }
.task-link {
  background:#172746;
  color:white;
  padding:9px 15px;
  border-radius:10px;
  text-decoration:none;
  font-size:.88rem;
  font-weight:700;
  white-space:nowrap;
}
.task-link:hover { background:#6550bb; }
.pending {
  color:#7d8ba1;
  background:#edf1f7;
  border-radius:10px;
  padding:8px 12px;
  font-size:.8rem;
  white-space:nowrap;
}
.empty {
  padding:30px;
  text-align:center;
  color:var(--muted);
}
footer {
  background:#15213a;
  color:#d3dded;
  margin-top:45px;
  padding:35px 0;
}
footer strong { color:white; }
footer p { margin:5px 0; font-size:.9rem; }
@media(max-width:720px) {
  .hero-inner { grid-template-columns:1fr; }
  .art { display:none; }
  .module-count { display:none; }
  .topic-body { padding:8px 14px 20px; }
  .topic-toggle { padding:15px 13px; gap:9px; }
  .task { flex-wrap:wrap; }
  .task-link,.pending { margin-left:auto; }
}
</style>
</head>

<body>

