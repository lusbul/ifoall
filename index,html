const catalog = document.getElementById("catalog");
const search = document.getElementById("search");
const filters = document.getElementById("filters");

let selectedModule = 0;
let query = "";
const expanded = new Set();

function escapeHTML(value) {
  return String(value).replace(/[&<>"']/g, c => ({
    "&":"&amp;",
    "<":"&lt;",
    ">":"&gt;",
    '"':"&quot;",
    "'":"&#39;"
  })[c]);
}

function safeURL(url) {
  if (!url || !url.trim()) return "";
  try {
    const parsed = new URL(url, window.location.href);
    if (parsed.protocol !== "https:" &&
        parsed.protocol !== "http:") return "";
    return parsed.href;
  } catch {
    return "";
  }
}

function topicNumber(moduleIndex, topicIndex) {
  let n = topicIndex + 1;
  for (let i = 0; i < moduleIndex; i++) {
    n += modules[i].topics.length;
  }
  return String(n).padStart(2, "0");
}

function renderFilters() {
  const options = [
    {id:0,label:"Усі модулі"},
    ...modules.map(m => ({id:m.id,label:"Модуль " + m.id}))
  ];
  filters.innerHTML = options.map(o => `
    <button class="filter ${selectedModule===o.id?"active":""}"
      data-filter="${o.id}"
      aria-pressed="${selectedModule===o.id}">
      ${o.label}
    </button>
  `).join("");

  filters.querySelectorAll("button").forEach(btn => {
    btn.addEventListener("click", () => {
      selectedModule = Number(btn.dataset.filter);
      render();
    });
  });
}

function taskHTML(task) {
  const url = safeURL(task.url);
  return `
    <div class="task">
      <div class="task-icon">${escapeHTML(task.icon || "🧩")}</div>
      <div class="task-info">
        <div class="task-title">${escapeHTML(task.title)}</div>
        <div class="task-desc">${escapeHTML(task.desc || "")}</div>
      </div>
      ${url
        ? `<a class="task-link" href="${escapeHTML(url)}"
            target="_blank" rel="noopener noreferrer">
            Відкрити ↗
           </a>`
        : `<span class="pending">Незабаром</span>`
      }
    </div>
  `;
}

function render() {
  renderFilters();
  const sections = [];

  modules.forEach((module, mi) => {
    if (selectedModule && module.id !== selectedModule) return;

    const matching = module.topics
      .map((topic, ti) => ({topic,ti}))
      .filter(({topic}) => {
        const searchable = [
          topic.title, topic.desc,
          ...topic.tasks.flatMap(t => [t.title,t.desc])
        ].join(" ").toLowerCase();
        return searchable.includes(query);
      });

    if (!matching.length) return;

    const topicsHTML = matching.map(({topic,ti}) => {
      const key = `${module.id}-${ti}`;
      const isOpen = expanded.has(key) || Boolean(query);
      return `
        <article class="topic ${isOpen?"open":""}">
          <button class="topic-toggle"
            data-topic="${key}"
            aria-expanded="${isOpen}">
            <span class="number">${topicNumber(mi,ti)}</span>
            <span class="topic-name">${escapeHTML(topic.title)}</span>
            <span class="arrow">⌄</span>
          </button>
          <div class="topic-body">
            <p class="topic-description">${escapeHTML(topic.desc)}</p>
            <div class="tasks">
              ${topic.tasks.map(taskHTML).join("")}
            </div>
          </div>
        </article>
      `;
    }).join("");

    sections.push(`
      <section class="module" style="--accent:${module.color}">
        <div class="module-head">
          <div class="module-icon">${module.icon}</div>
          <div>
            <small>МОДУЛЬ ${module.id}</small>
            <h2>${escapeHTML(module.title)}</h2>
            <p>${escapeHTML(module.subtitle)}</p>
          </div>
          <div class="module-count">${module.topics.length} тем</div>
        </div>
        <div class="topic-list">${topicsHTML}</div>
      </section>
    `);
  });

  catalog.innerHTML = sections.join("") ||
    `<div class="empty">🔎 Нічого не знайдено. Спробуйте інший запит.</div>`;

  catalog.querySelectorAll("[data-topic]").forEach(btn => {
    btn.addEventListener("click", () => {
      const key = btn.dataset.topic;
      if (expanded.has(key)) expanded.delete(key);
      else expanded.add(key);
      render();
    });
  });
}

search.addEventListener("input", () => {
  query = search.value.trim().toLowerCase();
  render();
});

render();
</script>
